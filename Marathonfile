name: "My awesome tests"
outputDir: "marathon"
debug: false
vendorConfiguration:
  type: "Android"
  applicationApk: "app/build/outputs/apk/alpha/debug/app-alpha-debug.apk"
  testApplicationApk: "app/build/outputs/apk/androidTest/alpha/debug/app-alpha-debug-androidTest.apk"
  adbInitTimeoutMillis: 120000
  applicationPmClear: true
  testApplicationPmClear: true
  allureConfiguration:
    enabled: true
    relativeResultsDirectory: "/Documents/allure-results"
    pathRoot: "EXTERNAL_STORAGE"
filteringConfiguration:
  allowlist:
    - type: "fully-qualified-test-name"
      values:
        - "org.wikipedia.lesson25.tests.CloseBannersTest#closeBannersTest"
        - "org.wikipedia.lesson22.homework.ThemeWithWidgetTests#textSizeChangeTest"
        - "org.wikipedia.lesson22.homework.ThemeWithWidgetTests#themeSwitchTest"
poolingStrategy:
  type: "omni"
shardingStrategy:
  type: "parallel"
batchingStrategy:
  type: "isolate"